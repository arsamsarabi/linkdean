---
import '../styles/page.css'

const app = 'https://app.linkdean.app'
const docs = 'https://docs.linkdean.app'
const install = `${docs}/docs/self-hosting/quick-start`
const github = 'https://github.com/arsamsarabi/linkdean'
const signup = `${app}/register`
const roadmap = `${docs}/docs/roadmap`
const gettingStarted = `${docs}/docs/getting-started`
const comingNext = `${roadmap}#next-once-the-beta-settles`

// Coming next: the two roadmap items that close the biggest gaps on the docs' comparison page.
const archivePoints = [
  ['A copy of every page', 'A single-file HTML copy and a PDF, taken when you save. Opt-in.'],
  ['Search inside pages', 'Find a bookmark by what the page says, not only its title and notes.'],
  ['Downloads', 'Save any copy as HTML, PDF or reader-mode Markdown, or include them in your export.'],
  ['Dead links, still readable', 'When a link breaks, open its saved copy instead.'],
]
const aiPoints = [
  ['Your key or your server', 'Off by default. Bring your own API key, or run a local model on your own server.'],
  ['Tags and folders suggested', 'Suggestions as you save and file, applied only when you click.'],
  ['Summaries and search by meaning', 'A short summary per bookmark, and search for "that article about…".'],
  ['Vaults stay private', 'Nothing in a vault is ever sent to a model.'],
]

const themes = [
  { value: 'system', label: 'Use system theme', icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>' },
  {
    value: 'light',
    label: 'Light theme',
    icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  },
  { value: 'dark', label: 'Dark theme', icon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>' },
]

// The list pane of the app frame: real bookmarks from a sample library of public sites.
const rows = [
  ['RS', 1, 'doc.rust-lang.org', 'The Rust Programming Language', 'Unread', '', '2m'],
  ['TK', 3, 'tokio.rs', 'Tokio tutorial', 'Unread', '', '1h'],
  ['AX', 4, 'docs.rs', 'axum on docs.rs', 'Unread', '', '3h'],
  ['PG', 2, 'postgresql.org', 'PostgreSQL documentation', 'Pinned', 'is-you', '1d'],
  ['MD', 5, 'developer.mozilla.org', 'CSS reference, MDN', 'Read', 'is-done', '1d'],
  ['WD', 3, 'web.dev', 'Learn CSS', 'Read', 'is-done', '2d'],
  ['RE', 1, 'react.dev', 'Quick Start, React', 'Read', 'is-done', '3d'],
  ['TS', 4, 'typescriptlang.org', 'The TypeScript Handbook', 'Read', 'is-done', '4d'],
  ['GH', 2, 'github.com', 'GitHub', 'Pinned', 'is-you', '5d'],
  ['GF', 5, 'fonts.google.com', 'Google Fonts', 'Read', 'is-done', '6d'],
]

const tick =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 8.2 2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
const fileGlyph =
  '<svg class="ui-file__glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.25 2.75h8L18.75 7.25v14H6.25z"/><path d="M14 2.75v4.75h4.75M9 12.5h6.5M9 15.5h6.5M9 18.5h4"/></svg>'
const imports = [
  ['<img src="/assets/icons/chrome.svg" alt="">', 'bookmarks.html', 'Chrome'],
  ['<img src="/assets/icons/firefox.svg" alt="">', 'bookmarks.html', 'Firefox'],
  ['<img src="/assets/icons/safari.svg" alt="">', 'Bookmarks.html', 'Safari'],
  [fileGlyph, 'pocket.csv', 'Pocket'],
  [fileGlyph, 'raindrop.csv', 'Raindrop'],
  ['<img src="/assets/icons/json.svg" alt="">', 'linkdean.json', 'Linkdean'],
]


const title = 'Linkdean: bookmarks you can self-host'
const description =
  'Linkdean keeps your bookmarks in folders and tags, finds them with full-text search, locks private links in encrypted vaults, and runs on your own server if you want.'
---

<!doctype html>
<html lang="en" data-type="software" data-radius="soft" data-ground="sky" data-buttons="arrow" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1618" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <script is:inline>
      // Apply the saved theme before first paint. No saved choice means follow the system.
      ;(function () {
        try {
          var t = localStorage.getItem('linkdean-theme')
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
        } catch (e) {}
      })()
    </script>
    <link rel="preload" href="/fonts/Rajdhani-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <link rel="stylesheet" href="/assets/ui/base.css" />
    <link rel="stylesheet" href="/assets/ui/window/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/search/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/files/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/checklist/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/toggles/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/terminal-run/fragment.css" />
    <link rel="stylesheet" href="/assets/ui/notify/fragment.css" />
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
    <script is:inline>
      // Page views on Linkdean's own GoatCounter: no cookies, nothing stored in the browser.
      // Skipped when the browser sends Do Not Track or Global Privacy Control.
      ;(function () {
        var n = navigator
        if (n.doNotTrack === '1' || n.globalPrivacyControl === true) return
        window.goatcounter = {
          path: function () {
            return location.host + location.pathname
          },
        }
        var s = document.createElement('script')
        s.async = true
        s.dataset.goatcounter = 'https://stats.linkdean.app/count'
        s.src = 'https://stats.linkdean.app/count.js'
        document.head.appendChild(s)
      })()
    </script>
  </head>
  <body>
    <!-- type: software
         deal: hero centred, nav nav-mega, close close-word, footer footer-dark, rhythm surface-pairs,
         buttons arrow, mark: the client's logo, grounds: lit ground (sky, recoloured to the brand)
         palette: the brand's own (Purple Pain accent, by the client's request); type: the brand's
         Rajdhani and Satoshi in place of the dealt Host Grotesk
         moments: none; effect: none (the hero frame holds the real library screen) -->
    <header class="nav">
      <div class="wrap nav__bar">
        <a class="skip-link" href="#search">Skip to content</a>
        <a class="nav__logo" href="#top" aria-label="Linkdean home">
          <img class="only-light" src="/images/linkdean-horizontal-color.svg" alt="" width="76" height="32" />
          <img class="only-dark" src="/images/linkdean-horizontal-white.svg" alt="" width="76" height="32" />
        </a>
        <nav class="nav__links" aria-label="Main">
          <div class="nav__item">
            <a class="nav__link" href="#search"
              >Product <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"
                ><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
              ></a
            >
            <div class="nav__menu">
              <div class="wrap grid">
                <div class="menu-col span-3">
                  <p class="t-label">Organize</p>
                  <a href="#search">Search<span>Find any link with ⌘K</span></a>
                  <a href="#search">Folders and tags<span>One link, several folders</span></a>
                  <a href="#features">Library health<span>Broken links and duplicates</span></a>
                </div>
                <div class="menu-col span-3">
                  <p class="t-label">Share and move</p>
                  <a href="#features">Sharing<span>Shared folders, public lists</span></a>
                  <a href="#features">Import<span>Browser, Pocket, Raindrop</span></a>
                  <a href="#vaults">Vaults<span>Encrypted private folders</span></a>
                </div>
                <a class="menu-card span-3 start-10" href="#search">
                  <div class="panel">
                    <picture>
                      <source data-theme-dark srcset="/images/product/palette-dark.webp" media="(prefers-color-scheme: dark)" />
                      <img class="frame__img" src="/images/product/palette-light.webp" alt="The command palette searching the library for rust" width="1000" height="418" />
                    </picture>
                  </div>
                  <span class="t-card">Command palette</span>
                  <span class="t-small muted">Search, jump or add with ⌘K</span>
                </a>
              </div>
            </div>
          </div>
          <div class="nav__item"><a class="nav__link" href="#vaults">Vaults</a></div>
          <div class="nav__item"><a class="nav__link" href="#self-host">Self-host</a></div>
          <div class="nav__item"><a class="nav__link" href="#faq">Questions</a></div>
          <div class="nav__item"><a class="nav__link" href={docs}>Docs</a></div>
          <div class="nav__item"><a class="nav__link" href={roadmap}>Roadmap</a></div>
          <div class="nav__item">
            <a class="nav__link nav__link--icon" href={github} aria-label="Linkdean on GitHub"
              ><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                ></path></svg
              ><span class="nav__link-text">GitHub</span></a
            >
          </div>
        </nav>
        <div class="nav__actions">
          <a class="nav__link" href={`${app}/login`}>Sign in</a>
          <a class="btn btn--primary" href={signup}>Sign up free</a>
        </div>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero hero--centred" aria-labelledby="hero-h">
        <div class="wrap">
          <div class="hero-text">
            <div class="hero__c">
              <a class="pill" href={docs}><span>Free during the 2026 public beta</span><span class="muted">Read the docs</span></a>
              <h1 id="hero-h" aria-label="Bookmarks you can self-host">
                <img class="hero-mark" src="/favicon.svg" alt="" width="32" height="32" /> Bookmarks you can self-host
              </h1>
              <p class="hero__lead">
                Save links into folders and tags, find any of them with full-text search, and keep private ones in encrypted vaults. Use our server or run
                your own.
              </p>
              <div class="btn-row">
                <a class="btn btn--primary" href={signup}
                  >Sign up free<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"
                    ><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg
                  ></a
                >
                <a class="btn btn--secondary" href={install}>Read the install guide</a>
              </div>
            </div>
            <div class="hero__window" role="img" aria-label="The Linkdean library in grid view: bookmarks with page previews, folders, tags and the sidebar">
              <div class="ly-piece shot" aria-hidden="true">
                <picture>
                  <source data-theme-dark srcset="/images/product/library-dark.webp" media="(prefers-color-scheme: dark)" />
                  <img src="/images/product/library-light.webp" alt="" width="1600" height="1000" fetchpriority="high" data-source="client" data-subject="Linkdean library" />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="search" aria-labelledby="search-h">
        <div class="wrap">
          <div class="grid">
            <h2 id="search-h" class="span-6">Search every bookmark from one palette</h2>
            <p class="span-6 start-7 muted">
              Press ⌘K to search titles, notes and addresses, jump to a folder or add a link. Unread links wait in your reading list until you open them. <a
                class="link"
                href="#features">See what else it does</a
              >
            </p>
          </div>
          <div class="ui app fill" role="img" aria-label="The Linkdean library list beside the command palette searching for rust" data-ui-pause-host>
            <div class="app__pane app__pane--list">
              <div class="ui ui-panel ui-win" data-ui="window" data-open="Unread" data-work="Opening" data-done="Read">
                <div class="ui-win__bar">
                  <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="ui-win__crumb"><img class="ui-brand" src="/favicon.svg" alt="" width="16" height="16" />Library <i>/</i> <b>Development</b></span>
                  <span class="ui-spacer"></span>
                  <span class="ui-win__search" aria-hidden="true"
                    ><svg class="ui-icon" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3"></path></svg><span class="ui-win__ph">Search</span><span
                      class="ui-kbd">/</span
                    ></span
                  >
                </div>
                <div class="ui-win__body">
                  <nav class="ui-win__side" aria-hidden="true">
                    <span class="ui-win__nav is-on"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><path d="M4 2.5h8v11l-4-2.5-4 2.5z"></path></svg>Library<em>16</em></span
                    >
                    <span class="ui-win__nav"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5"></circle><path d="M8 5v3l2 1.5"></path></svg>Reading list<em>4</em></span
                    >
                    <span class="ui-win__nav"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><path d="m8 2.5 1.7 3.5 3.8.5-2.8 2.6.7 3.8L8 11.1l-3.4 1.8.7-3.8L2.5 6.5l3.8-.5z"></path></svg>Favorites<em>4</em></span
                    >
                    <span class="ui-win__label">Folders</span>
                    <span class="ui-win__nav"><span class="ui-win__hash">#</span>Development</span>
                    <span class="ui-win__nav"><span class="ui-win__hash">#</span>Design</span>
                    <span class="ui-win__nav"><span class="ui-win__hash">#</span>Cooking</span>
                  </nav>
                  <div class="ui-win__main">
                    <div class="ui-win__cols" aria-hidden="true"><span>Site</span><span>Title</span><span>Status</span><span>Saved</span></div>
                    <ul class="ui-win__rows">
                      {
                        rows.map(([ini, tone, site, name, st, cls, age]) => (
                          <li class="ui-win__row" data-row>
                            <span class="ui-avatar" data-tone={tone}>
                              {ini}
                            </span>
                            <span class="ui-win__who">{site}</span>
                            <span class="ui-win__sub">{name}</span>
                            <span class={`ui-win__st ${cls}`} data-st>
                              {st}
                            </span>
                            <span class="ui-win__age">{age}</span>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
            <div class="app__pane app__pane--open" data-ui-loop>
              <div class="ui ui-panel ui-search" data-ui="search">
                <div class="ui-search__field">
                  <svg class="ui-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3"></path></svg>
                  <span class="ui-search__q"><span data-search-q>rust</span><i class="ui-search__caret"></i></span>
                  <kbd class="ui-search__kbd">⌘K</kbd>
                </div>
                <div class="ui-search__group">Bookmarks and folders</div>
                <ul class="ui-search__list" data-search-list>
                  <li class="ui-search__row is-sel">
                    <span class="ui-search__ico"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><path d="M2.5 4.5h4l1 1.5h6v6.5h-11z"></path></svg></span
                    ><span class="ui-search__t">Development / <b>Rust</b></span><span class="ui-search__m">Folder</span>
                  </li>
                  <li class="ui-search__row">
                    <span class="ui-search__ico"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><path d="M4 2.5h8v11l-4-2.5-4 2.5z"></path></svg></span
                    ><span class="ui-search__t">The <b>Rust</b> Programming Language</span><span class="ui-search__m">doc.rust-lang.org</span>
                  </li>
                  <li class="ui-search__row">
                    <span class="ui-search__ico"
                      ><svg class="ui-icon" viewBox="0 0 16 16"><path d="M4 2.5h8v11l-4-2.5-4 2.5z"></path></svg></span
                    ><span class="ui-search__t">Tokio tutorial, tagged <b>rust</b></span><span class="ui-search__m">tokio.rs</span>
                  </li>
                </ul>
                <div class="ui-search__foot"><span><kbd>&uarr;</kbd><kbd>&darr;</kbd> to move</span><span><kbd>Enter</kbd> to open</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features" style="--hm: 2" aria-labelledby="features-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="features-h">Health checks, imports and sharing for bookmarks. <span class="muted">Built in, for every account.</span></h2>
          </div>
          <div class="grid">
            <article class="card card--row card--open span-4">
              <h3>Bookmark health checks</h3>
              <p>A background check flags dead links. Open, edit, recheck or remove each one in place.</p>
              <div class="panel">
                <div class="stage stage--fade-b">
                  <div class="at-rise fit" style="--fit-max:340px;--ax:max(24px, 50% - 170px);--ay:40px;--ay-sm:32px" data-ui-loop>
                    <div class="ui ui-panel ui-checks" data-ui="checklist">
                      <div class="ui-checks__head">
                        <div class="ui-title">Library health</div>
                        <span class="ui-spacer"></span>
                        <div class="ui-meta" data-checks-count>2 of 5</div>
                      </div>
                      <div class="ui-checks__bar"><i data-checks-bar style="--k:0.4"></i></div>
                      <ul class="ui-checks__list">
                        <li class="ui-check is-done"><span class="ui-check__box"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"></path></svg></span><span class="ui-check__label">Check 16 links</span></li>
                        <li class="ui-check is-done"><span class="ui-check__box"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"></path></svg></span><span class="ui-check__label">Merge 2 duplicates</span></li>
                        <li class="ui-check"><span class="ui-check__box"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"></path></svg></span><span class="ui-check__label">Recheck bbcgoodfood.com</span></li>
                        <li class="ui-check"><span class="ui-check__box"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"></path></svg></span><span class="ui-check__label">Fix the address of one link</span></li>
                        <li class="ui-check"><span class="ui-check__box"><svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"></path></svg></span><span class="ui-check__label">Remove one dead link</span></li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </article>
            <article class="card card--row card--open span-4">
              <h3>Bookmark imports from any browser</h3>
              <p>Bring browser HTML, Pocket or Raindrop CSV, or a Linkdean export. Previews fill in afterwards.</p>
              <div class="panel">
                <div class="stage stage--fade-r">
                  <div class="at-corner wide" style="--w:440px;--ax:28px;--ay:36px;--ay-sm:28px">
                    <div class="ui ui-files" data-ui="files" data-reading="Importing {n} of {total}">
                      <div class="ui-files__status"><span class="ui-dot"></span><span data-files-status>6 files imported</span></div>
                      <ul class="ui-files__grid">
                        {
                          imports.map(([icon, name, kind]) => (
                            <li class="ui-file is-done">
                              <span class="ui-file__icon" set:html={icon} />
                              <span class="ui-file__name">{name}</span>
                              <span class="ui-file__kind">{kind}</span>
                              <span class="ui-file__bar">
                                <i />
                              </span>
                              <span class="ui-file__check" set:html={tick} />
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </article>
            <article class="card card--row card--open span-4">
              <h3>Shared bookmark folders and lists</h3>
              <p>Invite people to read or edit a folder, or turn a list into a public link you can revoke.</p>
              <div class="panel">
                <div class="stage stage--fade-b">
                  <div class="at-rise fit" style="--fit-max:360px;--ax:max(24px, 50% - 180px);--ay:40px;--ay-sm:32px">
                    <div class="ui ui-panel ui-toggles" data-ui="toggles">
                      <div class="ui-head">
                        <svg class="ui-icon ui-toggles__ico" viewBox="0 0 16 16" aria-hidden="true"
                          ><path d="M2.5 4.5h4l1 1.5h6v6.5h-11z"></path></svg
                        >
                        <div class="ui-title">Share Reading list</div>
                        <span class="ui-spacer"></span>
                        <div class="ui-meta" data-tg-count>2 of 4 on</div>
                      </div>
