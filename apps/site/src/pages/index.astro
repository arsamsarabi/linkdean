    <script is:inline>
      // Theme picker: system (default, nothing stored), light or dark.
      ;(function () {
        var root = document.documentElement
        var current = root.dataset.theme || 'system'
        var inputs = document.querySelectorAll('.theme-picker input')
        var dark = window.matchMedia('(prefers-color-scheme: dark)')
        function tone() {
          var isDark = current === 'dark' || (current === 'system' && dark.matches)
          root.dataset.tone = isDark ? 'dark' : 'light'
          // Theme-swapped pictures: the dark source follows the chosen theme.
          var media = current === 'system' ? '(prefers-color-scheme: dark)' : current === 'dark' ? 'all' : 'not all'
          document.querySelectorAll('source[data-theme-dark]').forEach(function (s) {
            s.media = media
          })
        }
        tone()
        inputs.forEach(function (i) {
          i.checked = i.value === current
          i.addEventListener('change', function () {
            current = i.value
            if (current === 'system') delete root.dataset.theme
            else root.dataset.theme = current
            try {
              if (current === 'system') localStorage.removeItem('linkdean-theme')
              else localStorage.setItem('linkdean-theme', current)
            } catch (e) {}
            tone()
          })
        })
        dark.addEventListener('change', tone)
      })()
    </script>
