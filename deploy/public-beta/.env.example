# Public beta guest — copy to .env on the LXD VM. Never commit .env.

# Required
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
SESSION_SECRET=
TUNNEL_TOKEN=

# Public URLs
APP_URL=https://app.linkdean.app
LINKDEAN_VERSION=latest
LOG_FORMAT=json
TRUST_FORWARDED_FOR=true

# Optional screenshots: docker compose --profile chrome up -d
# BROWSER_WS_URL=http://chrome:9222

# Before announce (leave unset until ready)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# MAIL_FROM="Linkdean <no-reply@linkdean.app>"
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# REQUIRE_VERIFIED_EMAIL=true
# BLOCK_DISPOSABLE_EMAILS=true

# Optional
# METRICS_TOKEN=
# BOOTSTRAP_TOKEN=
# HSTS_MAX_AGE=31536000
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
