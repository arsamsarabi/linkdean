# Public beta LXD guest — SoT is Infisical homelab/prod /linkdean-public.
# On Nova: bash deploy/public-beta/scripts/render-env-from-infisical.sh
# Never commit a real .env. Full key list: docs/self-hosting/environment.md + BACKUP.md.

# Required
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
SESSION_SECRET=
TUNNEL_TOKEN=

# Public URLs / runtime
APP_URL=https://app.linkdean.app
# Image tag: a release version such as 0.0.2. The Release workflow rewrites this line on
# each app release (deploy/public-beta/scripts/pull-update.sh), so leave it pinned.
LINKDEAN_VERSION=latest
LOG_FORMAT=json
TRUST_FORWARDED_FOR=true
# RUST_LOG=info

# Optional screenshots: docker compose --profile chrome up -d
# BROWSER_WS_URL=http://chrome:9222

# Mail and sign-up controls (on for the public beta)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# MAIL_FROM="Linkdean <no-reply@linkdean.app>"
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_VERIFIED_EMAIL=true
BLOCK_DISPOSABLE_EMAILS=true

# Optional
# METRICS_TOKEN=
# BOOTSTRAP_TOKEN=
# HSTS_MAX_AGE=31536000
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Restic / B2 — store in the same Infisical folder; render-env strips these from Compose .env.
# See BACKUP.md. Used only by Nova ~/novabot/restic/backup-linkdean.sh
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
# RESTIC_PASSWORD=
# RESTIC_BUCKET_LINKDEAN=linkdean-public
