# HTTP only — TLS terminates at Cloudflare. cloudflared reaches this on :80.
{
	auto_https off
}

# www and apex share one site. Do not redirect to https:// here — TLS is at
# Cloudflare; an origin 301 to https://linkdean.app just re-enters the edge.
# Prefer a Cloudflare Redirect Rule for www → apex if you want a single hostname.
http://linkdean.app, http://www.linkdean.app {
	root * /srv/site
	encode gzip
	file_server
	try_files {path} /index.html
}

http://docs.linkdean.app {
	root * /srv/docs
	encode gzip
	file_server
	try_files {path} /index.html
}

http://app.linkdean.app {
	encode gzip
	reverse_proxy api:8080
}
