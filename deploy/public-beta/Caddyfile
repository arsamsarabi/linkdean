# HTTP only — TLS terminates at Cloudflare. cloudflared reaches this on :80.

www.linkdean.app {
	redir https://linkdean.app{uri} permanent
}

linkdean.app {
	root * /srv/site
	encode gzip
	file_server
	try_files {path} /index.html
}

docs.linkdean.app {
	root * /srv/docs
	encode gzip
	file_server
	try_files {path} /index.html
}

app.linkdean.app {
	encode gzip
	reverse_proxy api:8080
}
