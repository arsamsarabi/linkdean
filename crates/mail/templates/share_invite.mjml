{% extends "layout.mjml" %}
{% block title %}{{ owner }} shared a {{ subject_kind }} with you{% endblock %}
{% block preview %}{{ owner }} shared the {{ subject_kind }} “{{ name }}” with you ({{ access }}).{% endblock %}
{% block content %}
{% from "macros.mjml" import action %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="700">{{ owner }} shared a {{ subject_kind }} with you</mj-text>
    <mj-text>{{ owner }} shared the {{ subject_kind }} “{{ name }}” with you ({{ access }}).</mj-text>
    <mj-text>Accept or decline the invite in Linkdean.</mj-text>
    {{ action(url, "Open Linkdean") }}
  </mj-column>
</mj-section>
{% endblock %}
{% block why %}You got this because email for {{ kind_label }} is on. Turn it off in <a href="{{ settings_url }}" style="color:#636772">Settings → Notifications</a>.{% endblock %}
