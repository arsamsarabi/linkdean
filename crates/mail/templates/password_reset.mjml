{% extends "layout.mjml" %}
{% block title %}Reset your password{% endblock %}
{% block preview %}Reset your {{ site.instance }} password. The link works for {{ minutes }} minutes.{% endblock %}
{% block content %}
{% from "macros.mjml" import action %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="700">Reset your password</mj-text>
    <mj-text>Someone asked to reset the password for this account. The link works once, for {{ minutes }} minutes.</mj-text>
    {{ action(reset_url, "Reset your password") }}
    <mj-text>If this wasn't you, ignore this email; your password stays the same.</mj-text>
  </mj-column>
</mj-section>
{% endblock %}
{% block why %}You got this email because a password reset was requested for your account.{% endblock %}
