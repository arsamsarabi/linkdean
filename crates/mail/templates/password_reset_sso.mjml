{% extends "layout.mjml" %}
{% block title %}About your sign-in{% endblock %}
{% block preview %}Your {{ site.instance }} account signs in with single sign-on.{% endblock %}
{% block content %}
{% from "macros.mjml" import action %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="700">You sign in with single sign-on</mj-text>
    <mj-text>Someone asked to reset the password for this address, but this account has no password: it signs in with your organization's single sign-on.</mj-text>
    {{ action(site.app_url ~ "/login", "Sign in") }}
  </mj-column>
</mj-section>
{% endblock %}
{% block why %}You got this email because a password reset was requested for your account.{% endblock %}
