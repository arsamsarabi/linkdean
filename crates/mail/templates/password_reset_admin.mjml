{% extends "layout.mjml" %}
{% block title %}A password reset link was created{% endblock %}
{% block preview %}An admin of {{ site.instance }} created a password reset link for you.{% endblock %}
{% block content %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="700">A password reset link was created</mj-text>
    <mj-text>An admin of {{ site.instance }} created a password reset link for your account. They will send it to you. If you didn't ask for one, tell them.</mj-text>
  </mj-column>
</mj-section>
{% endblock %}
{% block why %}You got this email because an admin created a password reset link for your account.{% endblock %}
