{% extends "layout.mjml" %}
{% block title %}Your password was changed{% endblock %}
{% block preview %}Your {{ site.instance }} password was changed and every device was signed out.{% endblock %}
{% block content %}
{% from "macros.mjml" import action %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="700">Your password was changed</mj-text>
    <mj-text>Your password was changed at {{ changed_at }} and every device was signed out.</mj-text>
    <mj-text>Not you? Reset it again from the sign-in page and tell your admin.</mj-text>
    {{ action(site.app_url ~ "/login", "Sign in") }}
  </mj-column>
</mj-section>
{% endblock %}
{% block why %}You got this email because the password for your account was changed.{% endblock %}
