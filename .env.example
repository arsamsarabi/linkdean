# Generate each secret with `openssl rand -hex 32`. Hex stays valid inside DATABASE_URL.
# Docker Compose (production) requires these three:
# POSTGRES_PASSWORD=
# MEILI_MASTER_KEY=
# SESSION_SECRET=

# Local development only. The API refuses the well-known values below without it.
ALLOW_DEFAULT_SECRETS=true

# Required
DATABASE_URL=postgres://linkdean:linkdean@127.0.0.1:5432/linkdean
# Reserved for future cookie/HMAC signing (sessions use hashed opaque tokens in Postgres today).
SESSION_SECRET=replace-with-long-random-string
APP_URL=http://localhost:8080

# Optional
BIND=0.0.0.0:8080
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=dev_master_key_change_me
SESSION_DAYS=30
STATIC_DIR=apps/web/dist
AVATAR_DIR=./data/avatars
# Screenshots + cached favicon/OG binaries (Compose volume: previews)
PREVIEW_DIR=./data/previews
# CORS: comma-separated origins. Default = APP_URL. Use * for any origin (homelab/dev only).
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Behind a reverse proxy, read client addresses from X-Forwarded-For for login limits.
# Leave off when the API is reachable directly, because anyone can forge the header.
# TRUST_FORWARDED_FOR=true
# Headless Chrome CDP (compose: http://chrome:9222). Unset = skip screenshots.
# BROWSER_WS_URL=http://127.0.0.1:9222

# Broken-link checker (in-process worker). Defaults shown.
# LINK_CHECK_ENABLED=true
# LINK_CHECK_TICK_SECS=60
# LINK_CHECK_BATCH_SIZE=40
# LINK_CHECK_CONCURRENCY=2
# LINK_CHECK_PER_HOST_DELAY_MS=1000
# LINK_CHECK_RECHECK_DAYS=7

# Optional OIDC (Authentik / any provider)
# OIDC_ISSUER=https://auth.example.com/application/o/linkdean/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
